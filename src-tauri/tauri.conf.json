{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeterLuma",
  "version": "0.1.0",
  "identifier": "app.meterluma.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "MeterLuma",
      "width": 1180,
      "height": 860,
      "minWidth": 380,
      "minHeight": 640,
      "resizable": true,
      "visible": false,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "licenseFile": "../LICENSE",
    "resources": { "../LICENSE": "LICENSE", "../PRIVACY.md": "PRIVACY.md", "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt" },
    "shortDescription": "All your AI usage, one glance.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
